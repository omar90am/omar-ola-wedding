rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function phoneLikeId(id) { return id.matches('^\\+?[0-9]{7,17}$'); }
    function canonicalGuestId(id) { return id.matches('^[0-9]{7,15}$'); }
    function validSide(value) { return value == 'العريس' || value == 'العروس'; }
    function validStatus(value) { return value == 'يحضر' || value == 'يعتذر' || value == 'yes' || value == 'no'; }
    function rsvpOpen() { return request.time < timestamp.value(1797973200000); }
    function validGuestShape(id) {
      return canonicalGuestId(id) && request.resource.data.phoneCanonical == id && request.resource.data.phoneE164 == '+' + id
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && validSide(request.resource.data.side) && validStatus(request.resource.data.status)
        && request.resource.data.guestsCount in ['0','1','2','3','4','5','6']
        && request.resource.data.inviteId is string && request.resource.data.inviteId.matches('^RSVP-[A-Z0-9-]{8,40}$');
    }
    function guestCreateAllowed(id) {
      return validGuestShape(id) && request.resource.data.keys().hasOnly(['name','phone','phoneE164','phoneCanonical','phoneCountry','phoneDialCode','side','status','guestsCount','wishes','specialRequestType','specialRequest','inviteId','updatedAt','timestamp']);
    }
    function guestUpdateAllowed(id) {
      return canonicalGuestId(id) && request.resource.data.phoneCanonical == id && resource.data.phoneCanonical == id
        && request.resource.data.phoneCanonical == resource.data.phoneCanonical && request.resource.data.phoneE164 == resource.data.phoneE164
        && request.resource.data.side == resource.data.side && request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','status','guestsCount','wishes','specialRequestType','specialRequest','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && validStatus(request.resource.data.status) && request.resource.data.guestsCount in ['0','1','2','3','4','5','6'];
    }
    function validMemory() {
      return signedIn() && request.resource.data.keys().hasOnly(['type','guestName','message','caption','storagePath','contentType','size','ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['text','voice','photo']
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 300
        && request.resource.data.storagePath is string && request.resource.data.storagePath.size() <= 300
        && request.resource.data.contentType is string && request.resource.data.contentType.size() <= 100
        && request.resource.data.size is int && request.resource.data.size >= 0 && request.resource.data.size <= 12582912;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /guests/{guestId} {
      allow get: if isAdmin() || phoneLikeId(guestId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (rsvpOpen() && guestCreateAllowed(guestId));
      allow update: if isAdmin() || (rsvpOpen() && guestUpdateAllowed(guestId));
      allow delete: if isAdmin();
    }
    match /phoneboothMemories/{memoryId} {
      allow create: if validMemory();
      allow read, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}

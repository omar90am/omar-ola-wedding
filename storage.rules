rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    match /phonebooth/{uid}/{kind}/{fileName} {
      allow create: if isOwner(uid)
        && (kind == 'voice' || kind == 'photo')
        && request.resource.size <= (kind == 'voice' ? 12582912 : 8388608)
        && (kind == 'voice' ? request.resource.contentType.matches('audio/.*') : request.resource.contentType.matches('image/.*'));
      allow read, update, delete: if isOwner(uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
